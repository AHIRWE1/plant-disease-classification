FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-dashboard.txt .
RUN python -m pip install --no-cache-dir -r requirements-dashboard.txt

RUN groupadd --gid 10001 app \
    && useradd --uid 10001 --gid 10001 --create-home app \
    && mkdir -p /app/dashboard /app/visualizations \
    && chown -R app:app /app

COPY --chown=app:app dashboard ./dashboard
COPY --chown=app:app visualizations/class_distribution.png visualizations/image_feature_comparisons.png visualizations/feature_interpretations.txt ./visualizations/

USER app
EXPOSE 8501

CMD ["streamlit", "run", "dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
